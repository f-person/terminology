#define TABBAR_VERTICAL_RESIZE_W 13

group { name: "terminology/tabbar_vertical/base";
   images.image: "icon-tab-btn-060.png" COMP;
   parts {
      part { name: "clip"; type: RECT;
         description { state: "default" 0.0;
         }
      }
      // full width of the bar, along the edge facing the terminals
      part { name: "terminology.width"; type: SWALLOW;
         description { state: "default" 0.0;
            rel1.relative: 1.0 0.0;
            align: 1.0 0.5;
            fixed: 1 0;
         }
         description { state: "right" 0.0;
            inherit: "default" 0.0;
            rel1.relative: 0.0 0.0;
            rel2.relative: 0.0 1.0;
            align: 0.0 0.5;
         }
      }
      part { name: "bg"; type: RECT;
         clip_to: "clip";
         description { state: "default" 0.0;
            rel.to: "terminology.width";
            color_class: "/bg/normal/tab";
         }
      }
      // tab button
      part { name: "tab_btn_tile"; type: SPACER;
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "terminology.width";
            rel2.relative: 1.0 0.0;
            align: 0.5 0.0;
            min: 0 24;
            fixed: 0 1;
         }
      }
      part { name: "tab_btn_inner"; type: SPACER;
         description { state: "default" 0.0;
            rel1.to: "tab_btn_tile";
            rel2.to_x: "terminology.resize";
            rel2.to_y: "tab_btn_tile";
            rel2.relative: 0.0 1.0;
         }
         description { state: "right" 0.0;
            inherit: "default" 0.0;
            rel1.to_x: "terminology.resize";
            rel1.relative: 1.0 0.0;
            rel2.to: "tab_btn_tile";
            rel2.relative: 1.0 1.0;
         }
      }
      part { name: "tab_btn_bg"; mouse_events: 0;
         clip_to: "clip";
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "tab_btn_inner";
            min: 15 15;
            max: 15 15;
            fixed: 1 1;
            image.normal: "icon-tab-btn-060.png";
            color_class: "/fg/normal/term/tab_button";
         }
         description { state: "pressed" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/pressed/term/tab_button";
         }
      }
      part { name: "tab_btn_separator"; type: RECT; mouse_events: 0;
         clip_to: "clip";
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "tab_btn_tile";
            rel1.relative: 0.0 1.0;
            rel1.offset: 0 -1;
            min: 0 1;
            align: 0.5 1.0;
            fixed: 0 1;
            color_class: "/shadow/normal/tab";
         }
      }
      part { name: "tab_btn_ev"; type: RECT;
         clip_to: "clip";
         description { state: "default" 0.0;
            rel.to: "tab_btn_tile";
            color: 0 0 0 0; // no cc
         }
      }
      part { name: "terminology.content"; type: SWALLOW;
         clip_to: "clip";
         description { state: "default" 0.0;
            rel1.to_x: "terminology.width";
            rel1.to_y: "tab_btn_tile";
            rel1.relative: 0.0 1.0;
            rel2.to: "terminology.width";
         }
      }
      // line along the edge facing the terminals
      part { name: "resize_line_area"; type: SPACER;
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "terminology.width";
            rel1.relative: 1.0 0.0;
            align: 1.0 0.5;
            min: 2 0;
            max: 2 99999;
            fixed: 1 0;
         }
         description { state: "right" 0.0;
            inherit: "default" 0.0;
            rel1.relative: 0.0 0.0;
            rel2.relative: 0.0 1.0;
            align: 0.0 0.5;
         }
      }
      part { name: "resize_line"; type: RECT; mouse_events: 0;
         clip_to: "clip";
         description { state: "default" 0.0;
            rel.to: "resize_line_area";
            color_class: "/bg/selected/tab/hilight";
            color: 255 255 255 0; // no cc
         }
         description { state: "on" 0.0;
            inherit: "default" 0.0;
            color: 255 255 255 255; // no cc
         }
      }
      // area to drag to resize the bar
      part { name: "terminology.resize"; type: SWALLOW;
         clip_to: "clip";
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "terminology.width";
            rel1.relative: 1.0 0.0;
            align: 1.0 0.5;
            min: TABBAR_VERTICAL_RESIZE_W 0;
            max: TABBAR_VERTICAL_RESIZE_W 99999;
            fixed: 1 0;
         }
         description { state: "right" 0.0;
            inherit: "default" 0.0;
            rel1.relative: 0.0 0.0;
            rel2.relative: 0.0 1.0;
            align: 0.0 0.5;
         }
      }
   }
   programs {
      program { signal: "position,left"; source: "terminology";
         action: STATE_SET "default" 0.0;
         target: "terminology.width";
         target: "tab_btn_inner";
         target: "resize_line_area";
         target: "terminology.resize";
      }
      program { signal: "position,right"; source: "terminology";
         action: STATE_SET "right" 0.0;
         target: "terminology.width";
         target: "tab_btn_inner";
         target: "resize_line_area";
         target: "terminology.resize";
      }
      program { signal: "mouse,clicked,1"; source: "tab_btn_ev";
         action: SIGNAL_EMIT "tab,go" "terminology";
      }
      program { signal: "mouse,clicked,3"; source: "tab_btn_ev";
         action: SIGNAL_EMIT "tab,new" "terminology";
      }
      program { signal: "mouse,wheel,0,1"; source: "tab_btn_ev";
         action: SIGNAL_EMIT "tab,prev" "terminology";
      }
      program { signal: "mouse,wheel,0,-1"; source: "tab_btn_ev";
         action: SIGNAL_EMIT "tab,next" "terminology";
      }
      program { signal: "mouse,down,*"; source: "tab_btn_ev";
         action: STATE_SET "pressed" 0.0;
         target: "tab_btn_bg";
      }
      program { signal: "mouse,up,*"; source: "tab_btn_ev";
         action: STATE_SET "default" 0.0;
         transition: DECELERATE 0.3;
         target: "tab_btn_bg";
      }
      program { signal: "resize,on"; source: "terminology";
         action: STATE_SET "on" 0.0;
         transition: DECELERATE 0.15;
         target: "resize_line";
      }
      program { signal: "resize,off"; source: "terminology";
         action: STATE_SET "default" 0.0;
         transition: DECELERATE 0.3;
         target: "resize_line";
      }
   }
}

group { name: "terminology/tabbar_vertical/item";
   set { name: "tab_grouped";
      image { image: "tab_grouped_8.png" COMP; size: 0 0 8 8; }
      image { image: "tab_grouped_16.png" COMP; size: 8 8 16 16; }
      image { image: "tab_grouped_32.png" COMP; size: 16 16 99999 99999; }
   }
   I060("tab_close", "close")
   styles {
      style { name: "tabbar_vertical_title";
         base: "font=Sans:style=Bold font_size=10 color=#ffffff wrap=mixed align=left";
      }
   }
   parts {
      part { name: "clip"; type: RECT;
         description { state: "default" 0.0;
         }
      }
      // under the bar's terminology.resize
      part { name: "edge"; type: SPACER;
         scale: 1;
         description { state: "default" 0.0;
            rel1.relative: 1.0 0.0;
            align: 1.0 0.5;
            min: TABBAR_VERTICAL_RESIZE_W 0;
            max: TABBAR_VERTICAL_RESIZE_W 99999;
            fixed: 1 0;
         }
         description { state: "right" 0.0;
            inherit: "default" 0.0;
            rel1.relative: 0.0 0.0;
            rel2.relative: 0.0 1.0;
            align: 0.0 0.5;
         }
      }
      part { name: "inner"; type: SPACER;
         description { state: "default" 0.0;
            rel2.to_x: "edge";
            rel2.relative: 0.0 1.0;
         }
         description { state: "right" 0.0;
            inherit: "default" 0.0;
            rel1.to_x: "edge";
            rel1.relative: 1.0 0.0;
            rel2.to_x: "clip";
            rel2.relative: 1.0 1.0;
         }
      }
      part { name: "bg"; type: RECT; mouse_events: 0;
         clip_to: "clip";
         description { state: "default" 0.0;
            color_class: "/bg/normal/tab";
         }
         description { state: "selected" 0.0;
            inherit: "default" 0.0;
            color_class: "/bg/normal/background";
         }
      }
      part { name: "drag_hilight"; type: RECT; mouse_events: 0;
         clip_to: "clip";
         description { state: "default" 0.0;
            color_class: "/bg/selected/tab/hilight";
            color: 255 255 255 0; // no cc
         }
         description { state: "drag" 0.0;
            inherit: "default" 0.0;
            color: 255 255 255 64; // no cc
         }
      }
      part { name: "separator"; type: RECT; mouse_events: 0;
         clip_to: "clip";
         scale: 1;
         description { state: "default" 0.0;
            rel1.relative: 0.0 1.0;
            rel1.offset: 0 -1;
            min: 0 1;
            align: 0.5 1.0;
            fixed: 0 1;
            color_class: "/shadow/normal/tab";
         }
      }
      part { name: "hilight"; type: RECT; mouse_events: 0;
         clip_to: "clip";
         scale: 1;
         description { state: "default" 0.0;
            rel.to: "inner";
            rel2.relative: 0.0 1.0;
            min: 3 0;
            max: 3 99999;
            align: 0.0 0.5;
            fixed: 1 0;
            color_class: "/bg/selected/tab/hilight";
            visible: 0;
         }
         description { state: "selected" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      part { name: "tabgrouped"; mouse_events: 0;
         clip_to: "clip";
         scale: 1;
         description { state: "default" 0.0;
            align: 0.0 0.5;
            fixed: 1 1;
            max: 0 0;
            rel1 {
               to_x: "hilight";
               relative: 1.0 0.0;
               offset: 3 3;
            }
            rel2 {
               to_x: "hilight";
               relative: 1.0 1.0;
               offset: 3 -4;
            }
            image.normal: "tab_grouped";
            color_class: "/fg/normal/tab/term/icon/grouped";
            visible: 0;
            offscale;
         }
         description { state: "grouped" 0.0;
            inherit: "default" 0.0;
            min: 15 15;
            max: 15 15;
            visible: 1;
         }
      }
      part { name: "terminology.title"; type: TEXTBLOCK; mouse_events: 0;
         clip_to: "clip";
         scale: 1;
         description { state: "default" 0.0;
            rel1 {
               to_x: "tabgrouped";
               relative: 1.0 0.0;
               offset: 6 4;
            }
            rel2 {
               to_x: "tabclose";
               relative: 0.0 1.0;
               offset: -5 -6;
            }
            text {
               style: "tabbar_vertical_title";
               min: 0 1;
            }
            color_class: "/fg/normal/term/tab/title/text";
            offscale;
         }
         description { state: "selected" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/selected/term/tab/title/text";
         }
         description { state: "bell" 0.0;
            inherit: "default" 0.0;
            color_class: "/fg/selected/term/tab/title/text/bell";
         }
      }
      part { name: "event"; type: RECT;
         description { state: "default" 0.0;
            color: 0 0 0 0; // no cc
         }
      }
      part { name: "tabclose";
         clip_to: "clip";
         scale: 1;
         description { state: "default" 0.0;
            image.normal: "tab_close";
            rel1.to: "inner";
            rel1.relative: 1.0 0.0;
            rel1.offset: -5 3;
            rel2.to: "inner";
            rel2.relative: 1.0 0.0;
            rel2.offset: -5 3;
            align: 1.0 0.0;
            max: 0 0;
            fixed: 1 1;
            color_class: "/fg/selected/term/tab/title/close";
            visible: 0;
            offscale;
         }
         description { state: "selected" 0.0;
            inherit: "default" 0.0;
            min: 15 15;
            max: 15 15;
            color: 255 255 255 160; // no cc
            visible: 1;
         }
         description { state: "over" 0.0;
            inherit: "selected" 0.0;
            color: 255 255 255 255; // no cc
         }
      }
   }
   programs {
      program { signal: "mouse,clicked,1"; source: "event";
         action: SIGNAL_EMIT "tab,activate" "terminology";
      }
      program { signal: "mouse,clicked,2"; source: "event";
         action: SIGNAL_EMIT "tab,close" "terminology";
      }
      program { signal: "mouse,down,1,double"; source: "event";
         action: SIGNAL_EMIT "tab,title" "terminology";
      }
      program { signal: "mouse,clicked,1"; source: "tabclose";
         action: SIGNAL_EMIT "tab,close" "terminology";
      }
      program { signal: "mouse,in"; source: "tabclose";
         action: STATE_SET "over" 0.0;
         target: "tabclose";
      }
      program { signal: "mouse,out"; source: "tabclose";
         action: STATE_SET "selected" 0.0;
         target: "tabclose";
      }
      program { signal: "selected"; source: "terminology";
         action: STATE_SET "selected" 0.0;
         target: "bg";
         target: "hilight";
         target: "terminology.title";
         target: "tabclose";
      }
      program { signal: "unselected"; source: "terminology";
         action: STATE_SET "default" 0.0;
         target: "bg";
         target: "hilight";
         target: "terminology.title";
         target: "tabclose";
      }
      program { signal: "bell"; source: "terminology";
         action: STATE_SET "bell" 0.0;
         target: "terminology.title";
      }
      program { signal: "bell,off"; source: "terminology";
         action: STATE_SET "default" 0.0;
         target: "terminology.title";
      }
      program { signal: "grouped,on"; source: "terminology";
         action: STATE_SET "grouped" 0.0;
         target: "tabgrouped";
      }
      program { signal: "grouped,off"; source: "terminology";
         action: STATE_SET "default" 0.0;
         target: "tabgrouped";
      }
      program { signal: "position,left"; source: "terminology";
         action: STATE_SET "default" 0.0;
         target: "edge";
         target: "inner";
      }
      program { signal: "position,right"; source: "terminology";
         action: STATE_SET "right" 0.0;
         target: "edge";
         target: "inner";
      }
      program { signal: "drag,on"; source: "terminology";
         action: STATE_SET "drag" 0.0;
         target: "drag_hilight";
      }
      program { signal: "drag,off"; source: "terminology";
         action: STATE_SET "default" 0.0;
         target: "drag_hilight";
      }
   }
}
